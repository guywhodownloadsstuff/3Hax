-- Variables

local StarterGui = game:GetService("StarterGui")
local Plr = game.Players.LocalPlayer

-- Functions

function Notification(Title,Text,Duration,Button)
	
	StarterGui:SetCore("SendNotification", {
		Title = Title,
		Text = Text,
		Duration = Duration,
		Button1 = Button,
	})
	
end

function OptionNotification(Title,Text,Duration,Button1,Button2,Action1,Action2)

	StarterGui:SetCore("SendNotification", {
		Title = Title,
		Text = Text,
		Duration = Duration,
		Button1 = Button1,
		Button2 = Button2,
		Callback = function(Choice)
			if Choice == Button1 then
				Action1()
			elseif Choice == Button2 then
				Action2()
			end
		end
	})

end

-- Setup

Notification("Breed Script (By 3Hax)","Get your friend to run this script then click him. (They will be highlighted.)",math.huge,"Understood")

local Invitable = Instance.new("Animation")
Invitable.AnimationId = "rbxassetid://69"
local Animation = Plr.Character:FindFirstChildOfClass("Humanoid"):LoadAnimation(Invitable)
Animation.Looped = true
Animation:Play()

while true do
	
	wait(1)
	
	for _, Player in game.Players:GetPlayers() do
		
		if Player ~= Plr and Player.Character and Player.Character:FindFirstChildOfClass("Humanoid") then
			
			for _, Anim in Player.Character:FindFirstChildOfClass("Humanoid"):GetPlayingAnimationTracks() do
				
				if Anim.Animation.AnimationId == "rbxassetid://69" and not Player.Character:FindFirstChild("BreedInv") then
					
					local Click = Instance.new("ClickDetector",Player.Character)
					Click.Name = "BreedInv"
					Click.CursorIcon = "rbxasset://textures/Cursors/KeyboardMouse/ArrowCursor.png"
					
					local Highlight = Instance.new("Highlight",Player.Character)
					Highlight.Name = "BreedHighlight"
					
					Highlight.FillTransparency = 1
					Highlight.FillColor = Color3.new(1,1,1)
					
					Click.MouseHoverEnter:Connect(function()
						
						game.TweenService:Create(Highlight,TweenInfo.new(0.3),{FillTransparency = 0.7}):Play()
						
					end)
					
					Click.MouseHoverLeave:Connect(function()

						game.TweenService:Create(Highlight,TweenInfo.new(0.3),{FillTransparency = 1}):Play()

					end)

					Click.MouseClick:Connect(function()
						
						game.TextChatService.TextChannels.RBXGeneral:SendAsync("/w " .. Player.DisplayName .. " request")
						
					end)
					
				end
				
			end
			
		end
		
	end
	
end

local TextChatService = game:GetService("TextChatService")

TextChatService.MessageReceived:Connect(function(Msg)
	
	if Msg.Text == '<font color="#f74b52">You are not able to chat with this person.</font>' then
		
		Notification("Error","This person does not have private messaging allowed, tell him to allow it.",10,"Oh")
		
	end
	
end)
